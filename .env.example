# ---- Supabase ---------------------------------------------------------------
# Project URL + anon (publishable) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role (secret) key — SERVER ONLY. Never prefix with NEXT_PUBLIC.
# Used for: signing view URLs, admin invites, and the purge job.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App --------------------------------------------------------------------
# Public origin of the deployed app — used for invite/magic-link redirects.
# Locally: http://localhost:3000 . On Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cron -------------------------------------------------------------------
# Shared secret protecting /api/cron/purge. Vercel Cron sends it automatically
# as `Authorization: Bearer <CRON_SECRET>` when this is set in the project env.
# Generate one: `openssl rand -hex 32`
CRON_SECRET=replace-with-a-long-random-string
